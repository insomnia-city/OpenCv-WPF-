<Application x:Class="HalconWorkflow.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HalconWorkflow.App.ViewModels"
             xmlns:ctrl="clr-namespace:HalconWorkflow.App.Controls"
             xmlns:nod="clr-namespace:Nodify;assembly=Nodify">
    <Application.Resources>

        <!-- Converters · 转换器 -->
        <ctrl:AccentToBrushConverter x:Key="AccentToBrush" />
        <ctrl:StateToBrushConverter x:Key="StateToBrush" />
        <ctrl:PortKindToBrushConverter x:Key="PortKindToBrush" />
        <ctrl:ConnectStateToBrushConverter x:Key="ConnectStateToBrush" />
        <ctrl:BoolToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="CardBg" Color="#FF263238" />
        <SolidColorBrush x:Key="CardBorder" Color="#FF455A64" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF5F5F5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FF90A4AE" />

        <!-- Transparent drag hotspot over a port dot (§4.3, stage-12). · 端口圆点上的透明拖拽热点(§4.3,阶段12) -->
        <Style x:Key="PortConnectorStyle" TargetType="{x:Type nod:Connector}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type nod:Connector}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared input port row: dot + label + live value badge (§5.4, stage-13) · 输入端口行：圆点+名称+运行值徽标 -->
        <DataTemplate x:Key="InputPortTemplate">
            <Grid Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
                    <Ellipse Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Stroke="{Binding Highlight, Converter={StaticResource ConnectStateToBrush}}" StrokeThickness="2" />
                    <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{Binding IsExec, Converter={StaticResource PortKindToBrush}}" Stroke="#FF102027" StrokeThickness="1" />
                    <nod:Connector Style="{StaticResource PortConnectorStyle}" IsConnected="{Binding IsConnected}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="12" />
                    <TextBlock Text="{Binding ValueText}" Foreground="{StaticResource TextSecondary}" FontSize="9"
                               TextTrimming="CharacterEllipsis" MaxWidth="150" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OutputPortTemplate">
            <Grid Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="12" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ValueText}" Foreground="{StaticResource TextSecondary}" FontSize="9"
                               TextTrimming="CharacterEllipsis" MaxWidth="150" HorizontalAlignment="Right" />
                </StackPanel>
                <Grid Grid.Column="1" Width="18" Height="18" VerticalAlignment="Center">
                    <Ellipse Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Stroke="{Binding Highlight, Converter={StaticResource ConnectStateToBrush}}" StrokeThickness="2" />
                    <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{Binding IsExec, Converter={StaticResource PortKindToBrush}}" Stroke="#FF102027" StrokeThickness="1" />
                    <nod:Connector Style="{StaticResource PortConnectorStyle}" IsConnected="{Binding IsConnected}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Standard node card · 标准节点卡片 (layout constants must match NodeViewModel anchors) -->
        <DataTemplate x:Key="NodeCardTemplate">
            <Border Width="{x:Static vm:NodeViewModel.CardWidth}"
                    Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="6" SnapsToDevicePixels="True">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <Border Height="{x:Static vm:NodeViewModel.HeaderHeight}"
                            Background="{Binding Header, Converter={StaticResource AccentToBrush}}" CornerRadius="6,6,0,0">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Header}" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ContractDisplay}" Foreground="#CCFFFFFF" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                        <Grid Margin="0,3,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource InputPortTemplate}" Margin="8,0,10,0" VerticalAlignment="Top" />
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource OutputPortTemplate}" Margin="10,0,8,0" VerticalAlignment="Top" />
                        </Grid>
                        <!-- Breakpoint indicator + elapsed badge · 断点指示+耗时徽标 -->
                        <Grid Margin="0,0,0,3" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="6" Height="6" Fill="#FFD32F2F" Visibility="{Binding IsBreakpoint, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Grid.Column="1" Text="{Binding LastElapsedMsText}" Foreground="#FF90A4AE" FontSize="9" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Start node: distinct accent + run badge · 起点节点：独立强调色+运行标记 -->
        <DataTemplate x:Key="StartNodeTemplate">
            <Border Width="{x:Static vm:NodeViewModel.CardWidth}"
                    Background="{StaticResource CardBg}" BorderBrush="#FF7C4DFF" BorderThickness="2"
                    CornerRadius="6" SnapsToDevicePixels="True">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <Border Height="30" Background="#FF7C4DFF" CornerRadius="4,4,0,0" Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Header}" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="► RUN" Foreground="White" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Height="{x:Static vm:NodeViewModel.PortsTop}" >
                        <TextBlock Text="{Binding Id}" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="8,2,0,0" VerticalAlignment="Top" />
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Suspended node: red card + reason · 挂起节点：红色卡片+原因 -->
        <DataTemplate x:Key="SuspendedNodeTemplate">
            <Border Width="{x:Static vm:NodeViewModel.CardWidth}"
                    Background="#FF311515" BorderBrush="#FFE53935" BorderThickness="2"
                    CornerRadius="6" SnapsToDevicePixels="True">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <Border Height="30" Background="#FFE53935" CornerRadius="4,4,0,0" Padding="8,0">
                        <TextBlock Text="{Binding ContractDisplay}" Foreground="White" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="8,6">
                        <TextBlock Text="⚠ Suspended" Foreground="#FFFF8A80" FontSize="11" />
                        <TextBlock Text="Plugin not loaded" Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Canvas connection line · 画布连线 -->
        <DataTemplate x:Key="ConnectionTemplate">
            <nod:Connection Source="{Binding Source}" Target="{Binding Target}" Stroke="#FF78909C" StrokeThickness="2">
                <nod:Connection.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding DisconnectLabel}" Command="{Binding DisconnectCommand}" />
                    </ContextMenu>
                </nod:Connection.ContextMenu>
            </nod:Connection>
        </DataTemplate>

        <!-- Dragged pending connection: dashed preview line (§4.3, stage-12). · 拖拽中的待定连线：虚线预览(§4.3,阶段12) -->
        <DataTemplate x:Key="PendingConnectionTemplate">
            <nod:PendingConnection IsVisible="True" Foreground="#FF4FC3F7" />
        </DataTemplate>

        <!-- Template routing: contract family → card · 模板路由：契约族 → 卡片 -->
        <ctrl:NodeTemplateSelector x:Key="NodeTemplateSelector"
                                   DefaultTemplate="{StaticResource NodeCardTemplate}"
                                   StartTemplate="{StaticResource StartNodeTemplate}"
                                   SuspendedTemplate="{StaticResource SuspendedNodeTemplate}" />

    </Application.Resources>
</Application>