<Window x:Class="HalconWorkflow.App.Views.SettingsDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF1C242C" Foreground="#FFECEFF1">

    <Window.Resources>
        <SolidColorBrush x:Key="FieldLabelBrush" Color="#FFB0BEC5" />
        <SolidColorBrush x:Key="PanelBorder" Color="#FF2C3A46" />
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB0BEC5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding CultureLabel}" Style="{StaticResource SettingsLabel}" Margin="0,0,10,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding CultureOptions}" SelectedItem="{Binding Culture}"
                      DisplayMemberPath="NativeName" Background="#FF263238" Foreground="#FFECEFF1" />
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding LogDirectoryLabel}" Style="{StaticResource SettingsLabel}" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" Text="{Binding LogDirectory}" Background="#FF263238"
                     Foreground="#FFECEFF1" BorderBrush="{StaticResource PanelBorder}" />
        </Grid>

        <CheckBox Content="{Binding PreviewLabel}" IsChecked="{Binding EnablePreview}"
                  Foreground="#FFECEFF1" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding RetentionLabel}" Style="{StaticResource SettingsLabel}" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" Text="{Binding TraceRetentionDays}" Background="#FF263238"
                     Foreground="#FFECEFF1" BorderBrush="{StaticResource PanelBorder}" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding OkLabel}" Command="{Binding SaveCommand}" IsDefault="True"
                    Padding="16,6" Margin="0,0,8,0" Background="#FF2E7D32" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold" />
            <Button Content="{Binding CancelLabel}" IsCancel="True" Padding="16,6"
                    Background="#FF37474F" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </StackPanel>
</Window>
