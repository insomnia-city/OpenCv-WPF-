<Window x:Class="HalconWorkflow.App.Views.ImageWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:HalconWorkflow.App.Controls"
        Title="{Binding NodeLabel}" Width="760" Height="560" WindowStartupLocation="CenterOwner"
        Background="#FF11151A">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#FF1C242C" />
        <SolidColorBrush x:Key="PanelBorder" Color="#FF2C3A46" />
        <SolidColorBrush x:Key="TextOnToolBar" Color="#FFECEFF1" />
        <cv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <cv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />
        <cv:BytesToImageConverter x:Key="BytesToImage" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar · 工具栏 -->
        <Border Grid.Row="0" Background="#FF17212A" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding PreviousLabel}" Command="{Binding PreviousCommand}" Padding="10,4" Margin="0,0,6,0"
                        Background="#FF263238" Foreground="{StaticResource TextOnToolBar}" BorderThickness="0" />
                <Button Content="{Binding NextLabel}" Command="{Binding NextCommand}" Padding="10,4" Margin="0,0,6,0"
                        Background="#FF263238" Foreground="{StaticResource TextOnToolBar}" BorderThickness="0" />
                <Button Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" Padding="10,4" Margin="0,0,14,0"
                        Background="#FF37474F" Foreground="{StaticResource TextOnToolBar}" BorderThickness="0" />

                <CheckBox Content="{Binding LiveLabel}" IsChecked="{Binding Live}" Foreground="{StaticResource TextOnToolBar}"
                          VerticalAlignment="Center" Margin="0,0,14,0" />
                <CheckBox Content="{Binding RoiLabel}" IsChecked="{Binding ShowRoi}" Foreground="{StaticResource TextOnToolBar}"
                          VerticalAlignment="Center" Margin="0,0,14,0" />
                <CheckBox Content="{Binding CrosshairLabel}" IsChecked="{Binding ShowCrosshair}" Foreground="{StaticResource TextOnToolBar}"
                          VerticalAlignment="Center" Margin="0,0,14,0" />

                <TextBlock Text="{Binding HistoryText}" Foreground="#FF90A4AE" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Image canvas · 图像画布 -->
        <Border Grid.Row="1" Background="#FF0E1318" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Margin="10,10,10,10">
            <Grid ClipToBounds="True">
                <TextBlock Text="{Binding HistoryText}" Foreground="#FF546E7A" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding CurrentImage, Converter={StaticResource InverseBoolToVis}}" />
                <Image Source="{Binding CurrentImage.Image, Converter={StaticResource BytesToImage}}"
                       Stretch="Uniform" Margin="4"
                       Visibility="{Binding CurrentImage, Converter={StaticResource BoolToVis}}" />

                <!-- Crosshair overlay · 十字线叠加 -->
                <Grid IsHitTestVisible="False" Visibility="{Binding ShowCrosshair, Converter={StaticResource BoolToVis}}">
                    <Rectangle VerticalAlignment="Center" Height="1" Fill="#80FFFFFF" Width="100000" />
                    <Rectangle HorizontalAlignment="Center" Width="1" Fill="#80FFFFFF" Height="100000" />
                </Grid>
            </Grid>
        </Border>

        <!-- Status bar · 状态栏 -->
        <Border Grid.Row="2" Background="#FF17212A" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock Text="{Binding NodeLabel}" Foreground="{StaticResource TextOnToolBar}" FontSize="12" />
        </Border>
    </Grid>
</Window>