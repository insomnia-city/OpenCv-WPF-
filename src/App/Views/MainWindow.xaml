<Window x:Class="HalconWorkflow.App.Views.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HalconWorkflow.App.ViewModels"
        xmlns:cv="clr-namespace:HalconWorkflow.App.Controls"
        xmlns:nod="clr-namespace:Nodify;assembly=Nodify"
        Title="{Binding AppTitle}" Width="1280" Height="820" WindowStartupLocation="CenterScreen"
        Background="#FF11151A">

    <Window.InputBindings>
        <KeyBinding Command="{Binding UndoCommand}" Key="Z" Modifiers="Control" />
        <KeyBinding Command="{Binding RedoCommand}" Key="Y" Modifiers="Control" />
    </Window.InputBindings>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#FF1C242C" />
        <SolidColorBrush x:Key="PanelBorder" Color="#FF2C3A46" />
        <SolidColorBrush x:Key="ToolBarBg" Color="#FF17212A" />
        <SolidColorBrush x:Key="TextOnToolBar" Color="#FFECEFF1" />
        <cv:ParameterKindVisibilityConverter x:Key="TextVis" Kind="Selection" Not="True" />
        <cv:ParameterKindVisibilityConverter x:Key="BoolVis" Kind="Boolean" Not="False" />
        <cv:ParameterKindVisibilityConverter x:Key="SelVis" Kind="Selection" Not="False" />
        <cv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <cv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />
        <cv:BytesToImageConverter x:Key="BytesToImage" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar · 工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource ToolBarBg}" Padding="8,6" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="{Binding MenuNew}" Command="{Binding NewCommand}" Margin="0,0,6,0" Padding="10,4" Background="#FF263238" Foreground="{StaticResource TextOnToolBar}" BorderThickness="0" />
                    <Button Content="{Binding MenuLoad}" Command="{Binding LoadCommand}" Margin="0,0,6,0" Padding="10,4" Background="#FF263238" Foreground="{StaticResource TextOnToolBar}" BorderThickness="0" />
                    <Button Content="{Binding MenuSave}" Command="{Binding SaveCommand}" Padding="10,4" Background="#FF263238" Foreground="{StaticResource TextOnToolBar}" BorderThickness="0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="18,0,0,0">
                    <Button Content="{Binding MenuUndo}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Padding="10,4" Margin="0,0,6,0"
                            Background="#FF37474F" Foreground="{StaticResource TextOnToolBar}" BorderThickness="0" />
                    <Button Content="{Binding MenuRedo}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Padding="10,4"
                            Background="#FF37474F" Foreground="{StaticResource TextOnToolBar}" BorderThickness="0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="18,0,0,0">
                    <Button Content="{Binding MenuRun}" Command="{Binding RunCommand}" Padding="14,4" Margin="0,0,6,0"
                            Background="#FF2E7D32" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                    <Button Content="{Binding MenuStop}" Command="{Binding StopCommand}" Padding="14,4"
                            Background="#FFB71C1C" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MenuLanguage}" Foreground="{StaticResource TextOnToolBar}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Culture}" Width="140"
                              DisplayMemberPath="NativeName" Background="#FF263238" Foreground="{StaticResource TextOnToolBar}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content · 主区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- Node library · 节点库 -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PaletteTitle}" Foreground="#FF90A4AE" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,8" />
                    <ListBox ItemsSource="{Binding Palette}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,2" Padding="8,6" Background="#FF263238" Foreground="#FFF5F5F5"
                                        BorderThickness="0" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.AddNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Contract}" Foreground="#FF90A4AE" FontSize="10" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Editor canvas + trace dashboard · 画布 + 追溯看板 -->
            <TabControl Grid.Column="1" Background="#FF11151A" BorderThickness="0" Padding="0">
                <TabItem Header="{Binding TabEditor}" Background="#FF1C242C" Foreground="#FFECEFF1">
                    <nod:NodifyEditor ItemsSource="{Binding Editor.Nodes}"
                                      Connections="{Binding Editor.Connections}"
                                      ConnectionTemplate="{StaticResource ConnectionTemplate}"
                                      Background="#FF11151A"
                                      Foreground="#FF78909C"
                                      GridCellSize="24">
                        <nod:NodifyEditor.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource NodeTemplateSelector}" />
                            </DataTemplate>
                        </nod:NodifyEditor.ItemTemplate>
                        <nod:NodifyEditor.ItemContainerStyle>
                            <Style TargetType="{x:Type nod:ItemContainer}">
                                <Setter Property="Location" Value="{Binding Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Setter Property="SelectedBrush" Value="#332196F3" />
                                <Setter Property="SelectedBorderThickness" Value="1.5" />
                                <EventSetter Event="Selected" Handler="OnItemSelected" />
                                <EventSetter Event="Unselected" Handler="OnItemUnselected" />
                            </Style>
                        </nod:NodifyEditor.ItemContainerStyle>
                    </nod:NodifyEditor>
                </TabItem>

                <TabItem Header="{Binding TabDashboard}" Background="#FF1C242C" Foreground="#FFECEFF1">
                    <Grid Background="#FF11151A" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Dashboard toolbar · 看板工具条 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Dashboard.Title}" Foreground="#FFECEFF1" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Button Content="{Binding Dashboard.RefreshLabel}" Command="{Binding Dashboard.RefreshCommand}"
                                    Padding="10,4" Margin="0,0,6,0" Background="#FF263238" Foreground="#FFF5F5F5" BorderThickness="0" />
                            <Button Content="{Binding Dashboard.ClearLabel}" Command="{Binding Dashboard.ClearCommand}"
                                    Padding="10,4" Margin="0,0,6,0" Background="#FF37474F" Foreground="#FFF5F5F5" BorderThickness="0" />
                            <Button Content="{Binding Dashboard.ExportLabel}" Command="{Binding Dashboard.ExportCommand}"
                                    Padding="10,4" Margin="0,0,14,0" Background="#FF2E7D32" Foreground="White" BorderThickness="0" />
                            <TextBlock Text="{Binding Dashboard.DimensionLabel}" Foreground="#FF90A4AE" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Dashboard.DimensionOptions}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding Dashboard.SelectedDimension}" Width="120" FontSize="11"
                                      Background="#FF263238" Foreground="#FFF5F5F5" />
                            <TextBlock Text="{Binding Dashboard.RangeText}" Foreground="#FF546E7A" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                            <TextBlock Text="{Binding Dashboard.StatusText}" Foreground="#FFEF9A9A" FontSize="11"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Summary cards · 汇总卡 -->
                        <Border Grid.Row="1" Background="#FF1C242C" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                            <UniformGrid Rows="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Dashboard.CyclesLabel}" Foreground="#FF90A4AE" FontSize="11" />
                                    <TextBlock Text="{Binding Dashboard.CyclesText}" Foreground="#FFECEFF1" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Dashboard.OkLabel}" Foreground="#FF90A4AE" FontSize="11" />
                                    <TextBlock Text="{Binding Dashboard.OkText}" Foreground="#FF81C784" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Dashboard.NgLabel}" Foreground="#FF90A4AE" FontSize="11" />
                                    <TextBlock Text="{Binding Dashboard.NgText}" Foreground="#FFE57373" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Dashboard.YieldLabel}" Foreground="#FF90A4AE" FontSize="11" />
                                    <TextBlock Text="{Binding Dashboard.YieldText}" Foreground="#FF64B5F6" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- Board table + slices/preview · 看板表 + 切片/预览 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FF141B22" BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="1" CornerRadius="4" Padding="8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Dashboard.RecordsLabel}" Foreground="#FF90A4AE"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Grid Grid.IsSharedSizeScope="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cSeq" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cTrigger" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cBatch" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cNode" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cKind" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cTs" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Dashboard.ColSeq}" Foreground="#FF78909C" FontSize="11" Margin="4,0,8,4" />
                                            <TextBlock Grid.Column="1" Text="{Binding Dashboard.ColTrigger}" Foreground="#FF78909C" FontSize="11" Margin="4,0,8,4" />
                                            <TextBlock Grid.Column="2" Text="{Binding Dashboard.ColBatch}" Foreground="#FF78909C" FontSize="11" Margin="4,0,8,4" />
                                            <TextBlock Grid.Column="3" Text="{Binding Dashboard.ColNode}" Foreground="#FF78909C" FontSize="11" Margin="4,0,8,4" />
                                            <TextBlock Grid.Column="4" Text="{Binding Dashboard.ColKind}" Foreground="#FF78909C" FontSize="11" Margin="4,0,8,4" />
                                            <TextBlock Grid.Column="5" Text="{Binding Dashboard.ColTs}" Foreground="#FF78909C" FontSize="11" Margin="4,0,8,4" />
                                        </Grid>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Dashboard.Records}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cSeq" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cTrigger" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cBatch" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cNode" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cKind" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cTs" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Seq}" Foreground="#FFB0BEC5" FontSize="11" Margin="4,2,8,2" />
                                                            <TextBlock Grid.Column="1" Text="{Binding TriggerId}" Foreground="#FFCFD8DC" FontSize="11" Margin="4,2,8,2" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Batch}" Foreground="#FFB0BEC5" FontSize="11" Margin="4,2,8,2" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Node}" Foreground="#FFB0BEC5" FontSize="11" Margin="4,2,8,2" />
                                                            <TextBlock Grid.Column="4" Text="{Binding Kind}" Foreground="#FFB0BEC5" FontSize="11" Margin="4,2,8,2" />
                                                            <TextBlock Grid.Column="5" Text="{Binding Ts}" Foreground="#FF90A4AE" FontSize="11" Margin="4,2,8,2" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#FF141B22" BorderBrush="{StaticResource PanelBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Dashboard.SlicesLabel}" Foreground="#FF90A4AE"
                                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <Grid Grid.IsSharedSizeScope="True">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="sNum" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="sNum" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="sNum" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="sYield" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Dashboard.ColKey}" Foreground="#FF78909C" FontSize="11" Margin="4,0,8,4" />
                                                <TextBlock Grid.Column="1" Text="{Binding Dashboard.ColCycles}" Foreground="#FF78909C" FontSize="11" Margin="4,0,8,4" />
                                                <TextBlock Grid.Column="2" Text="{Binding Dashboard.ColOk}" Foreground="#FF78909C" FontSize="11" Margin="4,0,8,4" />
                                                <TextBlock Grid.Column="3" Text="{Binding Dashboard.ColNg}" Foreground="#FF78909C" FontSize="11" Margin="4,0,8,4" />
                                                <TextBlock Grid.Column="4" Text="{Binding Dashboard.ColYield}" Foreground="#FF78909C" FontSize="11" Margin="4,0,8,4" />
                                            </Grid>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Dashboard.Slices}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="sNum" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="sNum" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="sNum" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="sYield" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Key}" Foreground="#FFECEFF1" FontSize="11" Margin="4,2,8,2" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Cycles}" Foreground="#FFCFD8DC" FontSize="11" Margin="4,2,8,2" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Ok}" Foreground="#FF81C784" FontSize="11" Margin="4,2,8,2" />
                                                                <TextBlock Grid.Column="3" Text="{Binding Ng}" Foreground="#FFE57373" FontSize="11" Margin="4,2,8,2" />
                                                                <TextBlock Grid.Column="4" Text="{Binding YieldText}" Foreground="#FF64B5F6" FontSize="11" Margin="4,2,8,2" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Row="2" Background="#FF141B22" BorderBrush="{StaticResource PanelBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Dashboard.PreviewLabel}" Foreground="#FF90A4AE"
                                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Dashboard.PreviewNode}" Foreground="#FFCFD8DC"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Dashboard.PreviewInfo}" Foreground="#FF78909C"
                                                   FontSize="10" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                                        <Border Background="#FF0E1318" BorderBrush="#FF2C3A46" BorderThickness="1" CornerRadius="3">
                                            <Grid>
                                                <TextBlock Text="{Binding Dashboard.NoPreviewLabel}" Foreground="#FF546E7A" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding Dashboard.HasPreview, Converter={StaticResource InverseBoolToVis}}" />
                                                <Image Source="{Binding Dashboard.PreviewImage, Converter={StaticResource BytesToImage}}"
                                                       Stretch="Uniform" Margin="4"
                                                       Visibility="{Binding Dashboard.HasPreview, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="{Binding TabAudit}" Background="#FF1C242C" Foreground="#FFECEFF1">
                    <Grid Background="#FF11151A" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Audit toolbar · 审计工具条 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding AuditView.Title}" Foreground="#FFECEFF1" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Button Content="{Binding AuditView.RefreshLabel}" Command="{Binding AuditView.RefreshCommand}"
                                    Padding="10,4" Margin="0,0,6,0" Background="#FF263238" Foreground="#FFF5F5F5" BorderThickness="0" />
                            <Button Content="{Binding AuditView.ClearLabel}" Command="{Binding AuditView.ClearCommand}"
                                    Padding="10,4" Margin="0,0,6,0" Background="#FF37474F" Foreground="#FFF5F5F5" BorderThickness="0" />
                            <Button Content="{Binding AuditView.ExportLabel}" Command="{Binding AuditView.ExportCommand}"
                                    Padding="10,4" Margin="0,0,14,0" Background="#FF2E7D32" Foreground="White" BorderThickness="0" />
                            <TextBlock Text="{Binding AuditView.UserLabel}" Foreground="#FF90A4AE" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding AuditView.FilterUser, UpdateSourceTrigger=PropertyChanged}" Width="90" FontSize="11"
                                     Background="#FF263238" Foreground="#FFF5F5F5" BorderThickness="0" Padding="4,2" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding AuditView.ActionLabel}" Foreground="#FF90A4AE" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding AuditView.FilterAction, UpdateSourceTrigger=PropertyChanged}" Width="110" FontSize="11"
                                     Background="#FF263238" Foreground="#FFF5F5F5" BorderThickness="0" Padding="4,2" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding AuditView.TargetLabel}" Foreground="#FF90A4AE" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding AuditView.FilterTarget, UpdateSourceTrigger=PropertyChanged}" Width="140" FontSize="11"
                                     Background="#FF263238" Foreground="#FFF5F5F5" BorderThickness="0" Padding="4,2" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding AuditView.RangeText}" Foreground="#FF546E7A" FontSize="11"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                            <TextBlock Text="{Binding AuditView.StatusText}" Foreground="#FFEF9A9A" FontSize="11"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Audit table · 审计表 -->
                        <Border Grid.Row="1" Background="#FF141B22" BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1" CornerRadius="4" Padding="8">
                            <Grid Grid.IsSharedSizeScope="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="aAt" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="aUser" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="aAction" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding AuditView.ColAt}" Foreground="#FF78909C" FontSize="11" Margin="4,0,10,4" />
                                    <TextBlock Grid.Column="1" Text="{Binding AuditView.ColUser}" Foreground="#FF78909C" FontSize="11" Margin="4,0,10,4" />
                                    <TextBlock Grid.Column="2" Text="{Binding AuditView.ColAction}" Foreground="#FF78909C" FontSize="11" Margin="4,0,10,4" />
                                    <TextBlock Grid.Column="3" Text="{Binding AuditView.ColTarget}" Foreground="#FF78909C" FontSize="11" Margin="4,0,10,4" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding AuditView.EmptyLabel}" Foreground="#FF546E7A" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding AuditView.HasRows, Converter={StaticResource InverseBoolToVis}}" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AuditView.Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="aAt" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="aUser" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="aAction" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding At}" Foreground="#FF90A4AE" FontSize="11" Margin="4,2,10,2" />
                                                    <TextBlock Grid.Column="1" Text="{Binding User}" Foreground="#FFCFD8DC" FontSize="11" Margin="4,2,10,2" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Action}" Foreground="#FF64B5F6" FontSize="11" Margin="4,2,10,2" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Target}" Foreground="#FFB0BEC5" FontSize="11" Margin="4,2,10,2" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Property panel + Log · 属性面板 + 日志 -->
            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,0,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding PropertyPanel.Title}" Foreground="#FF90A4AE" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,6" />
                    <TextBlock Grid.Row="1" Text="{Binding PropertyPanel.Header}" Foreground="#FF546E7A" FontSize="11"
                               Margin="0,0,0,6" TextTrimming="CharacterEllipsis" Visibility="{Binding PropertyPanel.HasTarget, Converter={StaticResource BoolToVis}}" />

                    <!-- Property rows / empty placeholder · 参数行/空提示 -->
                    <Border Grid.Row="2" Background="#FF141B22" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                            CornerRadius="4" Padding="6" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="{Binding PropertyPanel.EmptyText}" Foreground="#FF78909C" FontSize="11"
                                       VerticalAlignment="Top" TextWrapping="Wrap"
                                       Visibility="{Binding PropertyPanel.HasTarget, Converter={StaticResource InverseBoolToVis}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260"
                                          Visibility="{Binding PropertyPanel.HasTarget, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding PropertyPanel.Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="#FFF5F5F5" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding RangeText}" Foreground="#FF78909C" FontSize="10" Margin="6,1,0,0"
                                                               Visibility="{Binding HasRange, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Foreground="#FF78909C" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,4" />
                                                <TextBox Text="{Binding ValueString, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="4,2"
                                                         Background="#FF1C242C" Foreground="White" BorderBrush="#FF37474F"
                                                         Visibility="{Binding Kind, Converter={StaticResource TextVis}}" />
                                                <CheckBox IsChecked="{Binding BoolValue}" Foreground="White" FontSize="11"
                                                          Visibility="{Binding Kind, Converter={StaticResource BoolVis}}" />
                                                <ComboBox ItemsSource="{Binding Meta.Options}" FontSize="11" Padding="2"
                                                          Background="#FF1C242C" Foreground="White" BorderBrush="#FF37474F"
                                                          SelectedItem="{Binding SelectionValue}"
                                                          Visibility="{Binding Kind, Converter={StaticResource SelVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="3" Text="{Binding LogTitle}" Foreground="#FF90A4AE" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,8" />
                    <Border Grid.Row="5" Background="#FF141B22" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4" Padding="6">
                        <ListBox ItemsSource="{Binding Log.Entries}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas" FontSize="11">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Foreground="#FFCFD8DC" TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Setter Property="Padding" Value="0,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar · 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource ToolBarBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextOnToolBar}" FontSize="12" />
        </Border>
    </Grid>
</Window>