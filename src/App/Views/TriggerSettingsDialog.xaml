<Window x:Class="HalconWorkflow.App.Views.TriggerSettingsDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF1C242C" Foreground="#FFECEFF1">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorder" Color="#FF2C3A46" />
        <SolidColorBrush x:Key="InputBg" Color="#FF263238" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB0BEC5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16" HorizontalAlignment="Stretch">
        <CheckBox Content="{Binding EnableLabel}" IsChecked="{Binding Enabled}"
                  Foreground="#FFECEFF1" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}"
                  DisplayMemberPath="Name" Background="#FF263238" Foreground="#FFECEFF1"
                  Margin="0,4,0,12" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding IntervalLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" Text="{Binding IntervalMs}" Background="#FF263238"
                     Foreground="#FFECEFF1" BorderBrush="{StaticResource PanelBorder}" />
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding DebounceLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" Text="{Binding DebounceMs}" Background="#FF263238"
                     Foreground="#FFECEFF1" BorderBrush="{StaticResource PanelBorder}" />
        </Grid>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding TagLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" Text="{Binding Tag}" Background="#FF263238"
                     Foreground="#FFECEFF1" BorderBrush="{StaticResource PanelBorder}"
                     ToolTip="device/area/name" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding OkLabel}" IsDefault="True" Padding="16,6" Margin="0,0,8,0"
                    Background="#FF2E7D32" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    Click="OnOk" />
            <Button Content="{Binding CancelLabel}" IsCancel="True" Padding="16,6"
                    Background="#FF37474F" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </StackPanel>
</Window>