<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>HalconWorkflow.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Nodify" Version="7.3.0" />
    <!-- WPF interop for the image window. Must live here rather than in a net9.0 project:
         OpenCvSharp4.WpfExtensions only ships net48 and net8.0-windows7.0 assets, so a
         non-windows TFM silently falls back to the .NET Framework build and raises NU1701.
         This metapackage pulls OpenCvSharp4, OpenCvSharp4.runtime.win and
         OpenCvSharp4.WpfExtensions at the matching 4.13.0.20260627 version. -->
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HalconWorkflow.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\HalconWorkflow.Core.csproj" />
    <ProjectReference Include="..\Abstractions\HalconWorkflow.Abstractions.csproj" />
    <ProjectReference Include="..\Runtime\HalconWorkflow.Runtime.csproj" />
    <ProjectReference Include="..\Nodes.Flow\HalconWorkflow.Nodes.Flow.csproj" />
    <ProjectReference Include="..\Nodes.Vision\HalconWorkflow.Nodes.Vision.csproj" />
    <ProjectReference Include="..\Nodes.Comm\HalconWorkflow.Nodes.Comm.csproj" />
    <ProjectReference Include="..\Protocols\HalconWorkflow.Protocols.csproj" />
    <ProjectReference Include="..\MotionDrivers\HalconWorkflow.MotionDrivers.csproj" />
    <ProjectReference Include="..\Nodes.Motion\HalconWorkflow.Nodes.Motion.csproj" />
    <ProjectReference Include="..\Storage\HalconWorkflow.Storage.csproj" />
    <ProjectReference Include="..\Nodes.Data\HalconWorkflow.Nodes.Data.csproj" />
    <ProjectReference Include="..\Plugins\HalconWorkflow.Plugins.csproj" />
  </ItemGroup>

</Project>
